// Ta funkcja buduje panel OD ZERA, tylko jeśli PIN i login są poprawne
function toggleCreatorPanel() {
    const container = document.getElementById('adminPanelContainer');
    
    // Twarde sprawdzenie bezpieczeństwa przed wygenerowaniem czegokolwiek
    if (!isEditorUnlocked || !currentUser || currentUser.toLowerCase() !== 'admin') {
        container.innerHTML = ''; // Czyścimy wszystko, zero kodu dla intruza
        alert('⚠️ Odmowa dostępu. Brak autoryzacji.');
        return;
    }

    // Jeśli wszystko jest OK, wstrzykujemy kod HTML bezpośrednio do strony
    container.innerHTML = `
        <div id="creatorPanel" style="background: var(--card-bg); padding: 20px; border-radius: 8px; margin-top: 20px; border: 1px solid var(--accent-color);">
            <h3 style="margin-bottom: 15px; color: var(--accent-color);">⚙️ Panel Kontroli Administratora</h3>
            <form id="uploadForm">
                <div class="form-group">
                    <label>Tytuł projektu (Gry/Moda)</label>
                    <input type="text" id="prodTitle" required placeholder="np. Nowy mod do BeamNG">
                </div>
                <div class="form-group">
                    <label>Typ zawartości</label>
                    <select id="prodType">
                        <option value="gra">🎮 Gra</option>
                        <option value="mod">🔧 Mod</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Opis projektu</label>
                    <textarea id="prodDesc" required placeholder="Krótki opis funkcji..."></textarea>
                </div>
                <div class="form-group">
                    <label>Link do pobrania pliku</label>
                    <input type="url" id="prodLink" required placeholder="https://...">
                </div>
                <button type="submit" style="width: 100%; margin-top: 10px; background: var(--accent-color);">Opublikuj na stronie</button>
            </form>
        </div>
    `;

    // Podpinamy nasłuchiwanie pod nowo stworzony formularz
    document.getElementById('uploadForm').addEventListener('submit', handleAdminUpload);
}

// Funkcja obsługująca wysyłanie danych z bezpiecznego formularza
function handleAdminUpload(e) {
    e.preventDefault();
    
    // Ponowne zabezpieczenie przed wysłaniem lewych danych
    if (!isEditorUnlocked || !currentUser || currentUser.toLowerCase() !== 'admin') return;

    const newProduct = {
        id: Date.now(),
        title: document.getElementById('prodTitle').value,
        type: document.getElementById('prodType').value,
        desc: document.getElementById('prodDesc').value,
        link: document.getElementById('prodLink').value
    };

    database.unshift(newProduct);
    localStorage.setItem('dts_database', JSON.stringify(database));
    
    renderContent();
    
    // Po udanym dodaniu całkowicie niszczymy panel z widoku strony
    document.getElementById('adminPanelContainer').innerHTML = '';
    isEditorUnlocked = false;
    
    alert('🎉 Projekt został bezpiecznie stworzony i dodany do bazy danych!');
}
